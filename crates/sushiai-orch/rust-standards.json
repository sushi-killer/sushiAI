{
  "version": 1,
  "limits": {
    "production": 600,
    "test": 800,
    "entry": 150,
    "function": 100,
    "arguments": 5
  },
  "moduleEdges": {
    "task": ["policy"],
    "policy": ["task"],
    "harness": [
      "clock",
      "loop_detect",
      "policy",
      "procs",
      "prompts",
      "sandbox",
      "task",
      "worktree_env"
    ],
    "git": ["policy", "process", "procs", "task"],
    "verify": [
      "git",
      "harness",
      "policy",
      "procs",
      "prompts",
      "sandbox",
      "task",
      "test_failures",
      "worktree_env"
    ],
    "delivery": [
      "api",
      "git",
      "harness",
      "policy",
      "procs",
      "prompts",
      "sandbox",
      "task",
      "test_failures"
    ],
    "api": ["task", "engine", "policy", "prompts"],
    "store": ["task", "git", "process", "verify/repository", "precedents"],
    "engine": [
      "ab",
      "api",
      "clock",
      "costs",
      "delivery",
      "eval",
      "evolve",
      "git",
      "harness",
      "loop_detect",
      "overseer",
      "overseer_state",
      "policy",
      "precedents",
      "process",
      "procs",
      "prompts",
      "report",
      "sandbox",
      "skill",
      "store",
      "task",
      "test_failures",
      "timeline",
      "verify",
      "worktree_env"
    ],
    "prompts": ["task"],
    "process": [],
    "procs": ["process"],
    "sandbox": ["git"],
    "worktree_env": ["git", "process"],
    "loop_detect": ["policy"],
    "report": ["task", "git"],
    "test_failures": [],
    "timeline": ["task"],
    "costs": ["task", "store"],
    "ab": ["task", "store", "git"],
    "eval": ["task", "git", "store"],
    "evolve": ["task", "store"],
    "overseer": ["task", "harness", "prompts", "process"],
    "overseer_state": ["task", "store"],
    "precedents": ["task", "store"],
    "skill": ["task", "prompts", "git"],
    "legacy": ["process"],
    "verify/repository": ["task", "policy", "git"],
    "clock": []
  },
  "pureRoots": ["task", "policy"],
  "forbiddenPurePaths": [
    "std::fs",
    "std::io",
    "std::net",
    "std::process",
    "std::env",
    "std::thread",
    "tokio",
    "crate::engine",
    "crate::harness",
    "crate::git",
    "crate::store"
  ],
  "forbiddenPureSymbols": ["App"],
  "noReexportRoots": ["engine"],
  "dataRoots": ["prompts", "tests/fixtures", "evals"],
  "sharedSources": [
    {
      "path": "../process.rs",
      "reason": "Host modules independently share this process lifecycle IO adapter.",
      "max": 600
    }
  ],
  "exceptions": []
}
